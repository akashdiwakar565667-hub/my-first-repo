                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="container stats" aria-label="Channel stats">
          <div class="stat">
            <strong data-target="240">0</strong>
            <span>videos posted</span>
          </div>
          <div class="stat">
            <strong data-target="24">0</strong>
            <span>live streams</span>
          </div>
          <div class="stat">
            <strong data-target="8">0</strong>
            <span>million monthly fans</span>
          </div>
          <div class="stat">
            <strong data-target="96">0</strong>
            <span>community events</span>
          </div>
        </div>
      </section>

      <section id="videos">
        <div class="container">
          <div class="section-head">
            <h3>Featured drops</h3>
            <p>These are the moments that made the community go wild and keep the replay feed glowing.</p>
          </div>

          <div class="video-grid">
            <article class="video-card">
              <div class="thumb one">
                <span class="play-badge" aria-hidden="true"></span>
              </div>
              <div class="video-info">
                <div class="tag-row">
                  <span class="tag">Gaming</span>
                  <span class="tag">12 min</span>
                </div>
