<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NovaWave Fan Club</title>
    <meta
      name="description"
      content="NovaWave fan page - official fan club for a creative YouTuber and live streamer."
    />
    <style>
      :root {
        --bg: #0b1020;
        --bg-soft: #121b2f;
        --panel: rgba(19, 29, 51, 0.85);
        --panel-strong: rgba(11, 16, 32, 0.9);
        --line: rgba(255, 255, 255, 0.12);
        --text: #edf3ff;
        --muted: #a7b9d6;
        --pink: #ff5ec4;
        --purple: #8b5cf6;
        --blue: #38bdf8;
        --green: #32d583;
        --yellow: #ffd166;
        --shadow: 0 25px 60px rgba(8, 12, 26, 0.6);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background:
          radial-gradient(circle at top left, rgba(139, 92, 246, 0.3), transparent 28%),
          radial-gradient(circle at bottom right, rgba(56, 189, 248, 0.2), transparent 30%),
          var(--bg);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(18px);
        background: rgba(10, 13, 23, 0.52);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 76px;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .brand-badge {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--pink), var(--purple), var(--blue));
        box-shadow: 0 12px 30px rgba(139, 92, 246, 0.35);
        font-size: 0.75rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 26px;
        color: var(--muted);
        font-size: 0.96rem;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid transparent;
        border-radius: 999px;
        padding: 0.9rem 1.45rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        cursor: pointer;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-primary {
        color: white;
        background: linear-gradient(120deg, var(--pink), var(--purple), var(--blue));
        box-shadow: 0 20px 35px rgba(160, 92, 248, 0.34);
      }

      .button-secondary {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--line);
        color: var(--text);
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 64px 0 32px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 42px;
        align-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--line);
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        color: var(--muted);
        font-weight: 600;
        margin-bottom: 22px;
      }

      .live-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 0 rgba(50, 213, 131, 0.7);
        animation: pulse 1.8s infinite;
      }

      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(50, 213, 131, 0.75); }
        70% { box-shadow: 0 0 0 12px rgba(50, 213, 131, 0); }
        100% { box-shadow: 0 0 0 0 rgba(50, 213, 131, 0); }
      }

      h1 {
        margin: 0;
        font-size: clamp(2.6rem, 5vw, 5rem);
        line-height: 0.96;
        letter-spacing: -0.06em;
      }

      .gradient-text {
        background: linear-gradient(135deg, #fff 0%, #ff8bd3 30%, #9ad2ff 60%, #bda6ff 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        max-width: 610px;
        margin-top: 22px;
        font-size: 1.08rem;
        line-height: 1.8;
        color: var(--muted);
      }

      .cta-row {
        margin-top: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      .social-mini {
        margin-top: 28px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      .pill {
        padding: 0.5rem 0.8rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--line);
        font-size: 0.85rem;
      }

      .hero-art {
        position: relative;
        display: flex;
        justify-content: center;
      }

      .video-frame {
        position: relative;
        width: min(100%, 560px);
        border-radius: 32px;
        background: linear-gradient(160deg, rgba(148, 163, 184, 0.18), rgba(15, 23, 42, 0.5));
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: var(--shadow);
        padding: 16px;
      }

      .cover {
        position: relative;
        min-height: 620px;
        overflow: hidden;
        border-radius: 24px;
        background:
          linear-gradient(180deg, rgba(11, 16, 32, 0.2), rgba(11, 16, 32, 0.75)),
          url('https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
      }

      .cover-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255, 94, 196, 0.25), rgba(56, 189, 248, 0.2));
      }

      .cover-content {
        position: absolute;
        inset: auto 26px 26px 26px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .stream-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 0.5rem 0.8rem;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255,255,255,0.14);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .cover-content h2 {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3.2rem);
        letter-spacing: -0.05em;
      }

      .meta-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        color: rgba(255,255,255,0.8);
        font-size: 0.92rem;
      }

      .stats {
        margin-top: 30px;
        display: grid;
        grid-template-columns: repeat(4, minmax(120px, 1fr));
        gap: 18px;
      }

      .stat {
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 1rem 1.1rem;
      }

      .stat strong {
        display: block;
        font-size: clamp(1.5rem, 2.2vw, 2.1rem);
        letter-spacing: -0.05em;
      }

      .stat span {
        color: var(--muted);
        font-size: 0.84rem;
      }

      main section {
        padding: 76px 0;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 28px;
      }

      .section-head h3 {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3rem);
        letter-spacing: -0.05em;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 520px;
      }

      .video-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .video-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--line);
        border-radius: 24px;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .video-card:hover {
        transform: translateY(-4px);
        border-color: rgba(139, 92, 246, 0.6);
      }

      .thumb {
        height: 220px;
        position: relative;
        overflow: hidden;
      }

      .thumb.one { background: url('https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1200&q=80') center/cover; }
      .thumb.two { background: url('https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1200&q=80') center/cover; }
      .thumb.three { background: url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=1200&q=80') center/cover; }

      .play-badge {
        position: absolute;
        inset: 20px auto auto 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(11,16,32,0.7);
        border: 1px solid rgba(255,255,255,0.14);
      }

      .play-badge::before {
        content: "▶";
        margin-left: 4px;
        font-size: 1.2rem;
      }

      .video-info {
        padding: 20px 18px 22px;
      }

      .tag-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 12px;
      }

      .tag {
        border-radius: 999px;
        padding: 0.38rem 0.7rem;
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text);
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--line);
      }

      .video-info h4 {
        margin: 0 0 10px;
        font-size: 1.5rem;
        letter-spacing: -0.04em;
      }

      .video-info p {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .split {
        display: grid;
        grid-template-columns: 1fr 0.94fr;
        gap: 24px;
        align-items: center;
      }

      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 28px;
        padding: 24px;
        box-shadow: var(--shadow);
      }

      .community-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .mini-card {
        padding: 18px;
        border-radius: 18px;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--line);
      }

      .mini-card strong {
        font-size: 1.6rem;
        display: block;
        margin-top: 6px;
      }

      .mini-card span {
        color: var(--muted);
      }

      .bars {
        display: grid;
        gap: 18px;
        margin-top: 18px;
      }

      .progress-row {
        display: grid;
        gap: 8px;
      }

      .progress-name {
        display: flex;
        justify-content: space-between;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .progress-bar {
        position: relative;
        height: 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.06);
        border: 1px solid var(--line);
        overflow: hidden;
      }

      .progress-bar span {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--value);
        border-radius: inherit;
        background: linear-gradient(90deg, var(--pink), var(--purple), var(--blue));
      }

      .countdown-wrap {
        display: grid;
        gap: 20px;
      }

      .countdown {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
      }

      .time-box {
        padding: 16px 10px;
        background: rgba(255,255,255,0.025);
        border: 1px solid var(--line);
        border-radius: 18px;
        text-align: center;
      }

      .time-box strong {
        display: block;
        font-size: clamp(1.4rem, 3vw, 2rem);
        margin-bottom: 5px;
      }

      .time-box span {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
      }

      .cta-banner {
        border-radius: 30px;
        border: 1px solid var(--line);
        background: linear-gradient(135deg, rgba(255, 94, 196, 0.15), rgba(56,189,248,0.1), rgba(139,92,246,0.18));
        padding: clamp(1.5rem, 3vw, 2.5rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }

      .cta-banner h3 {
        margin: 0 0 10px;
        font-size: clamp(1.8rem, 3vw, 2.8rem);
        letter-spacing: -0.05em;
      }

      .cta-banner p {
        margin: 0;
        color: var(--muted);
      }

      footer {
        padding: 28px 0 60px;
        color: var(--muted);
      }

      .footer-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        border-top: 1px solid var(--line);
        padding-top: 22px;
      }

      @media (max-width: 860px) {
        .hero-grid,
        .split,
        .video-grid {
          grid-template-columns: 1fr;
        }

        .nav-links {
          display: none;
        }

        .stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .countdown {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 520px) {
        .stats,
        .community-box,
        .countdown {
          grid-template-columns: 1fr;
        }

        .cta-row {
          flex-direction: column;
          align-items: stretch;
        }

        .button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container nav">
        <a href="#top" class="brand" aria-label="NovaWave home">
          <span class="brand-badge">NW</span>
          <span>NovaWave</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="#videos">Videos</a>
          <a href="#community">Community</a>
          <a href="#schedule">Schedule</a>
          <a href="#join">Join</a>
        </nav>
        <a href="#join" class="button button-primary">Join the Crew</a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow"><span class="live-dot"></span> Live now on YouTube</div>
            <h1>
              We build <span class="gradient-text">big energy</span><br />
              for every drop.
            </h1>
            <p class="lead">
              NovaWave is the creator who turns everyday moments into hype, humor, and unforgettable stories.
              From gaming nights to behind-the-scenes chaos, this fan page keeps the vibes alive between uploads.
            </p>
            <div class="cta-row">
              <a href="#videos" class="button button-primary">Watch Best Moments</a>
              <a href="#schedule" class="button button-secondary">See Live Schedule</a>
            </div>
            <div class="social-mini">
              <span class="pill">2.4M subscribers</span>
              <span class="pill">4.8M weekly views</span>
              <span class="pill">#NovaWaveCrew</span>
            </div>
          </div>

          <div class="hero-art" aria-label="Featured stream artwork">
            <div class="video-frame">
              <div class="cover">
                <div class="cover-overlay"></div>
                <div class="cover-content">
                  <div class="stream-chip"><span class="live-dot"></span> Community live</div>
                  <h2>Night Quest<br />Arena</h2>
                  <div class="meta-row">
                    <span>1.2M views</span>
